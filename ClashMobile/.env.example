# ── Clash of Minds — Environment Variables ──────────────────────────
# Copy to .env and fill in your values

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=clashofminds
MYSQL_USER=clashuser
MYSQL_PASSWORD=clashpass

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Backend
JWT_SECRET=your_jwt_secret_here_change_this
PORT=3001
FRONTEND_URL=https://clashofminds.net
NODE_ENV=production

# Expo / EAS (for CI/CD)
EXPO_TOKEN=your_expo_token_here
